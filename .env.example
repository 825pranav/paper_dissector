# === LLM Providers (all free, no credit card) ===
# NOTE: put values directly after "=", with no trailing comment on the same line.
# python-dotenv treats the rest of the line as part of the value.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://console.mistral.ai/api-keys (optional backup, unused by default)
MISTRAL_API_KEY=

# === Literature search ===
# Default "auto": Semantic Scholar if its key is set, else OpenAlex. Whichever
# is preferred, the remaining keyless backends (OpenAlex, arXiv) are tried when
# it returns nothing. Force one with: openalex | arxiv | semantic_scholar
LITERATURE_PROVIDER=auto

# RECOMMENDED - free, instant and self-serve at https://openalex.org/rest-api
# OpenAlex periodically pauses ANONYMOUS search under load and returns HTTP 503;
# a key is exempt from that pause.
OPENALEX_API_KEY=

# Optional. A contact address puts OpenAlex requests in its faster polite pool.
# Left empty nothing is sent.
OPENALEX_MAILTO=

# Optional. Semantic Scholar's unauthenticated search 429s on nearly every call.
# A key lifts that, but is granted by application form, not instantly.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# === HuggingFace (free inference API, optional) ===
# Used for DeBERTa NLI stance classification. If absent or unavailable, the
# pipeline falls back to a batched LLM stance classifier automatically.
# https://huggingface.co/settings/tokens
HF_API_KEY=

# === Optional tuning (sensible defaults; override only if needed) ===
# Claim extraction, and figure reading unless GEMINI_VISION_MODEL is set:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash
# Auditor, debaters and judge:
# GROQ_MODEL=openai/gpt-oss-120b
# Query generation, staleness and stance (needs native JSON mode):
# GROQ_JSON_MODEL=qwen/qwen3.8-27b
# Claims analysed per paper - the main cost/time dial:
# MAX_CLAIMS=8
# MAX_DEBATE_ROUNDS=4
# MAX_PRAG_RETRIEVALS=2
# Paper excerpt sent to the auditor per claim:
# AUDIT_CONTEXT_CHARS=12000
# CONVERGENCE_THRESHOLD=0.85
# 0 to skip HF NLI and always use the LLM fallback:
# HF_ENABLED=1
# PAPER_DISSECTOR_CACHE_ENABLED=1
