# === LLM Providers (all free, no credit card) ===
# NOTE: put values directly after "=", with no trailing comment on the same line.
# python-dotenv treats the rest of the line as part of the value.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://console.mistral.ai/api-keys (optional backup, unused by default)
MISTRAL_API_KEY=

# === Literature search ===
# Default "auto": uses Semantic Scholar when a key is set below, OpenAlex
# otherwise. OpenAlex needs no key and is the practical default, because the
# unauthenticated Semantic Scholar search pool returns HTTP 429 almost always.
# Force a backend with: openalex | semantic_scholar
LITERATURE_PROVIDER=auto

# Optional. Supplying a contact address puts OpenAlex requests in its faster
# "polite pool". Left empty, the shared common pool is used.
OPENALEX_MAILTO=

# Optional. Raises Semantic Scholar's rate limit if you obtain a key (the
# request goes through an application form, so it is not instant).
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# === HuggingFace (free inference API, optional) ===
# Used for DeBERTa NLI stance classification. If absent or unavailable, the
# pipeline falls back to a batched LLM stance classifier automatically.
# https://huggingface.co/settings/tokens
HF_API_KEY=

# === Optional tuning (sensible defaults; override only if needed) ===
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# MAX_CLAIMS=8                 # claims analysed per paper - the main cost/time dial
# MAX_DEBATE_ROUNDS=4
# MAX_PRAG_RETRIEVALS=2
# AUDIT_CONTEXT_CHARS=60000    # paper text sent to the auditor per claim
# CONVERGENCE_THRESHOLD=0.85
# HF_ENABLED=1                 # 0 to skip HF NLI and always use the LLM fallback
# PAPER_DISSECTOR_CACHE_ENABLED=1
